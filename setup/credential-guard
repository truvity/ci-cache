#!/usr/bin/env bash
# A `credential_process` in front of the configured one, so that a credential
# that cannot be had stops being asked for.
#
#   credential-guard STATE-DIR BASE64-COMMAND
#
# gocacheprog writes this line into the plugin's private copy of the AWS
# config, in place of the original `credential_process`. The SDK runs it
# whenever it has no valid credential, which after a failure is EVERY
# request. The rule:
#
#   * The original command runs, bounded by the budget. Its answer, and its
#     stderr, pass through unchanged when it succeeds, and a success clears
#     the failure count: a credential that comes back is used.
#   * Each failure is counted, with the time it took. After
#     CI_CACHE_GO_CRED_ATTEMPTS failures in a row (default 3), or once
#     failures have cost CI_CACHE_GO_CRED_BUDGET seconds between them
#     (default 10), the bucket is OFF for the rest of this plugin process.
#     One line says so, with the last error. From then on this exits 1 at
#     once, without running anything, so each remaining request to the
#     bucket fails in the time it takes to start a shell.
#
# STATE-DIR belongs to one plugin process (gocacheprog makes a new one per
# start), so one go command giving up never turns the bucket off for the
# next.
set -uo pipefail

state="${1:?state dir}"
encoded="${2:?command}"

[ -d "$state/off" ] && exit 1

attempts="${CI_CACHE_GO_CRED_ATTEMPTS:-3}"
budget="${CI_CACHE_GO_CRED_BUDGET:-10}"
case "$attempts" in ''|*[!0-9]*|0) attempts=3 ;; esac
case "$budget" in ''|*[!0-9]*|0) budget=10 ;; esac

cmd="$(printf '%s' "$encoded" | base64 -d 2>/dev/null)" || exit 1

now() {
    if [ -n "${EPOCHREALTIME:-}" ]; then
        printf '%s\n' "${EPOCHREALTIME/,/.}"
    else
        date +%s
    fi
}

start="$(now)"
err="$(mktemp "$state/stderr.XXXXXX" 2>/dev/null)" || err=/dev/null
if command -v timeout >/dev/null 2>&1; then
    # GNU timeout signals the whole process group, so a grandchild holding
    # stdout open cannot keep this waiting past the budget.
    out="$(timeout -k 2 "$budget" sh -c "$cmd" 2>"$err")"
else
    out="$(sh -c "$cmd" 2>"$err")"
fi
rc=$?

if [ "$rc" -eq 0 ]; then
    rm -f "$state/failures"
    [ -s "$err" ] && cat "$err" >&2
    [ "$err" != /dev/null ] && rm -f "$err"
    printf '%s\n' "$out"
    exit 0
fi

elapsed="$(awk -v a="$start" -v b="$(now)" 'BEGIN { printf "%.3f", b - a }')"
printf '%s\n' "$elapsed" >> "$state/failures"
read -r count spent < <(awk '{ n++; t += $1 } END { printf "%d %.1f\n", n, t }' "$state/failures")

if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
    why="timed out after ${budget}s"
else
    why="$(grep -m1 . "$err" 2>/dev/null | cut -c1-300)"
    [ -n "$why" ] || why="exit status $rc"
fi
[ "$err" != /dev/null ] && rm -f "$err"

if [ "$count" -ge "$attempts" ] || awk -v t="$spent" -v b="$budget" 'BEGIN { exit !(t >= b) }'; then
    # mkdir is the test-and-set: exactly one caller gets to announce it.
    if mkdir "$state/off" 2>/dev/null; then
        printf 'ci-cache: the Go build cache could not get credentials (%d failed attempts, %ss; last: %s); the bucket is off for the rest of this go command, which carries on with its local cache\n' \
            "$count" "$spent" "$why" >&2
    fi
fi
exit 1
